@using pro_exam.Models

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة امتحان جديد</title>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #dce9f5, #eaf4fb);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .page-header {
            background: linear-gradient(135deg, #0d3b70, #1a6fa8);
            color: white;
            padding: 22px 30px;
            border-radius: 12px;
            margin-bottom: 28px;
            box-shadow: 0 4px 18px rgba(13, 59, 112, 0.35);
        }

        .page-header h3 { font-weight: 700; margin-bottom: 4px; }
        .page-header small { opacity: 0.85; font-size: 0.9rem; }

        .form-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 18px rgba(0,0,0,0.09);
            padding: 32px;
        }

        label {
            font-weight: 600;
            color: #0d3b70;
        }

        .form-control:focus,
        .custom-select:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 0.2rem rgba(26, 111, 168, 0.25);
        }

        .btn-submit {
            background: linear-gradient(135deg, #1e8449, #196f3d);
            color: white;
            font-weight: 700;
            border: none;
            padding: 11px 36px;
            border-radius: 8px;
            font-size: 1rem;
            transition: opacity 0.25s;
        }

        .btn-submit:hover { opacity: 0.9; color: white; }
        .btn-submit:disabled { opacity: 0.65; cursor: not-allowed; }

        .btn-cancel {
            background-color: #6c757d;
            color: white;
            font-weight: 600;
            border: none;
            padding: 11px 28px;
            border-radius: 8px;
            font-size: 1rem;
        }

        .btn-cancel:hover { background-color: #5a6268; color: white; }

        .section-divider {
            border: none;
            border-top: 2px solid #eaf4fb;
            margin: 24px 0;
        }

        .section-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1a6fa8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 16px;
        }

        .room-hint {
            background: #eaf4fb;
            border-right: 4px solid #1a6fa8;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 0.88rem;
            color: #0d3b70;
            margin-top: 8px;
        }
    </style>
</head>
<body>
<div class="container mt-4 mb-5" style="max-width: 760px;">

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-calendar-plus ml-2"></i>
                إضافة امتحان جديد
            </h3>
            <small>جدولة امتحان مع التحقق التلقائي من التعارضات وتوزيع القاعات</small>
        </div>
        <a href="@Url.Action("ExamDashBoard", "Exam")" class="btn btn-light btn-sm">
            <i class="fas fa-arrow-right ml-1"></i> العودة
        </a>
    </div>

    <!-- Form Card -->
    <div class="form-card">

        <!-- Section: Course & Doctor -->
        <p class="section-title"><i class="fas fa-info-circle ml-1"></i> معلومات الامتحان</p>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="selectDoctor">
                    <i class="fas fa-user-md ml-1"></i> الدكتور المراقب
                </label>
                <select id="selectDoctor" class="form-control custom-select" required>
                    <option value="">-- اختر الدكتور --</option>
                    @foreach (var doctor in (IEnumerable<Doctor>)ViewBag.Doctors)
                    {
                        <option value="@doctor.Id">@doctor.DoctorName</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-6">
                <label for="selectCourse">
                    <i class="fas fa-book ml-1"></i> المادة
                </label>
                <select id="selectCourse" class="form-control custom-select" required>
                    <option value="">-- اختر المادة --</option>
                    @foreach (var course in (IEnumerable<Course>)ViewBag.Courses)
                    {
                        <option value="@course.Id"
                                data-level="@course.Level"
                                data-students="@course.NumberOfStudents">
                            Level @course.Level — @course.CourseName (@course.Specialization)
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label>
                    <i class="fas fa-layer-group ml-1"></i> المستوى
                </label>
                <input type="text" id="displayLevel" class="form-control" readonly
                       placeholder="يُحدَّد تلقائياً" style="background:#f8f9fa;">
            </div>
            <div class="form-group col-md-8">
                <label for="inputStudents">
                    <i class="fas fa-users ml-1"></i> عدد الطلاب المتوقع
                </label>
                <input type="number" id="inputStudents" class="form-control"
                       placeholder="أدخل العدد المتوقع" min="1" max="500">
                <div class="room-hint" id="roomHint" style="display:none;">
                    <i class="fas fa-door-open ml-1"></i>
                    العدد يتجاوز 70 — سيُعرض خيار إضافة <strong>غرفة 2</strong> عند الحفظ.
                </div>
            </div>
        </div>

        <hr class="section-divider">

        <!-- Section: Date & Time -->
        <p class="section-title"><i class="fas fa-clock ml-1"></i> التوقيت</p>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="inputDate">
                    <i class="fas fa-calendar-alt ml-1"></i> تاريخ الامتحان
                </label>
                <input type="date" id="inputDate" class="form-control" required>
            </div>
            <div class="form-group col-md-6">
                <label for="inputTime">
                    <i class="fas fa-clock ml-1"></i> وقت الامتحان
                </label>
                <input type="time" id="inputTime" class="form-control" required>
            </div>
        </div>

        <hr class="section-divider">

        <!-- Actions -->
        <div class="d-flex justify-content-end" style="gap: 12px;">
            <a href="@Url.Action("ExamDashBoard", "Exam")" class="btn btn-cancel">
                <i class="fas fa-times ml-1"></i> إلغاء
            </a>
            <button type="button" id="btnSave" class="btn btn-submit">
                <i class="fas fa-save ml-1"></i> جدولة الامتحان
            </button>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Auto-fill level when course is selected
    $('#selectCourse').on('change', function () {
        var selected = $(this).find('option:selected');
        var level = selected.data('level');
        $('#displayLevel').val(level ? 'Level ' + level : '');
        checkStudentCount();
    });

    $('#inputStudents').on('input', function () {
        checkStudentCount();
    });

    function checkStudentCount() {
        var val = parseInt($('#inputStudents').val());
        if (val > 70) {
            $('#roomHint').show();
        } else {
            $('#roomHint').hide();
        }
    }

    function getFormData(addRoom2) {
        return {
            doctorId: parseInt($('#selectDoctor').val()),
            courseId: parseInt($('#selectCourse').val()),
            examDate: $('#inputDate').val(),
            examTime: $('#inputTime').val(),
            expectedStudents: parseInt($('#inputStudents').val()) || 0,
            addRoom2: addRoom2
        };
    }

    function validateForm() {
        if (!$('#selectDoctor').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار الدكتور المراقب', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#selectCourse').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار المادة', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#inputDate').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى تحديد تاريخ الامتحان', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#inputTime').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى تحديد وقت الامتحان', confirmButtonText: 'حسناً' });
            return false;
        }
        return true;
    }

    function submitExam(addRoom2) {
        var data = getFormData(addRoom2);

        $.ajax({
            url: '@Url.Action("AddExamAjax", "Exam")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res.status === 'success') {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم بنجاح',
                        text: res.message,
                        confirmButtonText: 'عرض جدول الامتحانات',
                        confirmButtonColor: '#0d3b70'
                    }).then(function () {
                        window.location.href = '@Url.Action("ExamDashBoard", "Exam")';
                    });

                } else if (res.status === 'needRoom2') {
                    Swal.fire({
                        icon: 'question',
                        title: 'إضافة غرفة إضافية',
                        text: res.message,
                        showCancelButton: true,
                        confirmButtonText: 'نعم، أضف غرفة 2',
                        cancelButtonText: 'لا، غرفة 1 فقط',
                        confirmButtonColor: '#1a6fa8',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        submitExam(result.isConfirmed);
                    });

                } else if (res.status === 'conflict') {
                    Swal.fire({
                        icon: 'error',
                        title: 'تعارض في الجدول',
                        text: res.message,
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#c0392b'
                    });

                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: res.message || 'حدث خطأ غير متوقع',
                        confirmButtonText: 'حسناً'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في الاتصال',
                    text: 'تعذّر الاتصال بالخادم. يرجى المحاولة مرة أخرى.',
                    confirmButtonText: 'حسناً'
                });
            }
        });
    }

    $('#btnSave').on('click', function () {
        if (!validateForm()) return;
        submitExam(false);
    });
</script>
</body>
</html>
