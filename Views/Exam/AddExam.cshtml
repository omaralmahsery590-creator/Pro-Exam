@using pro_exam.Models

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة امتحان جديد</title>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #dce9f5, #eaf4fb);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .page-header {
            background: linear-gradient(135deg, #0d3b70, #1a6fa8);
            color: white;
            padding: 22px 30px;
            border-radius: 12px;
            margin-bottom: 28px;
            box-shadow: 0 4px 18px rgba(13, 59, 112, 0.35);
        }

        .page-header h3 { font-weight: 700; margin-bottom: 4px; }
        .page-header small { opacity: 0.85; font-size: 0.9rem; }

        .form-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 18px rgba(0,0,0,0.09);
            padding: 32px;
        }

        label {
            font-weight: 600;
            color: #0d3b70;
        }

        .form-control:focus,
        .custom-select:focus {
            border-color: #1a6fa8;
            box-shadow: 0 0 0 0.2rem rgba(26, 111, 168, 0.25);
        }

        .btn-submit {
            background: linear-gradient(135deg, #1e8449, #196f3d);
            color: white;
            font-weight: 700;
            border: none;
            padding: 11px 36px;
            border-radius: 8px;
            font-size: 1rem;
            transition: opacity 0.25s;
        }

        .btn-submit:hover { opacity: 0.9; color: white; }
        .btn-submit:disabled { opacity: 0.65; cursor: not-allowed; }

        .btn-cancel {
            background-color: #6c757d;
            color: white;
            font-weight: 600;
            border: none;
            padding: 11px 28px;
            border-radius: 8px;
            font-size: 1rem;
        }

        .btn-cancel:hover { background-color: #5a6268; color: white; }

        .section-divider {
            border: none;
            border-top: 2px solid #eaf4fb;
            margin: 24px 0;
        }

        .section-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1a6fa8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 16px;
        }

        .extra-proctors-section {
            background: #eaf4fb;
            border-right: 4px solid #1a6fa8;
            border-radius: 8px;
            padding: 18px 20px;
            margin-top: 16px;
        }

        .extra-proctors-section .section-title {
            margin-bottom: 12px;
        }

        .btn-add-proctor {
            background: #1a6fa8;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-add-proctor:hover { background: #0d5a8e; }

        .btn-remove-proctor {
            background: #c0392b;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 0.8rem;
            cursor: pointer;
            margin-right: 8px;
        }

        .btn-remove-proctor:hover { background: #a93226; }
    </style>
</head>
<body>
<div class="container mt-4 mb-5" style="max-width: 760px;">

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-calendar-plus ml-2"></i>
                إضافة امتحان جديد
            </h3>
            <small>جدولة امتحان مع التحقق التلقائي من التعارضات وتوزيع القاعات</small>
        </div>
        <a href="@Url.Action("ExamDashBoard", "Exam")" class="btn btn-light btn-sm">
            <i class="fas fa-arrow-right ml-1"></i> العودة
        </a>
    </div>

    <!-- Form Card -->
    <div class="form-card">

        <!-- Section: Course & Doctor -->
        <p class="section-title"><i class="fas fa-info-circle ml-1"></i> معلومات الامتحان</p>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="selectDoctor">
                    <i class="fas fa-user-md ml-1"></i> الدكتور المراقب
                </label>
                <select id="selectDoctor" class="form-control custom-select" required>
                    <option value="">-- اختر الدكتور --</option>
                    @foreach (var doctor in (IEnumerable<Doctor>)ViewBag.Doctors)
                    {
                        <option value="@doctor.Id">@doctor.DoctorName</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-6">
                <label for="selectCourse">
                    <i class="fas fa-book ml-1"></i> المادة
                </label>
                <select id="selectCourse" class="form-control custom-select" required>
                    <option value="">-- اختر المادة --</option>
                    @foreach (var course in (IEnumerable<Course>)ViewBag.Courses)
                    {
                        <option value="@course.Id"
                                data-students="@course.NumberOfStudents">
                            @course.CourseName (@course.Specialization) -- Level @course.Level (@course.NumberOfStudents)
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="inputStudents">
                    <i class="fas fa-users ml-1"></i> عدد الطلاب المتوقع <span class="text-danger">*</span>
                </label>
                <input type="number" id="inputStudents" class="form-control"
                       placeholder="أدخل العدد المتوقع" min="1" max="500" required>
            </div>
            <div class="form-group col-md-6">
                <label for="selectRoom">
                    <i class="fas fa-door-open ml-1"></i> القاعة
                </label>
                <select id="selectRoom" class="form-control custom-select" required>
                    <option value="">-- اختر القاعة --</option>
                    @foreach (var room in (IEnumerable<Room>)ViewBag.Rooms)
                    {
                        <option value="@room.Id">@room.Name --Capacity (@room.Capacity)</option>
                    }
                </select>
            </div>
        </div>

        <!-- Extra Proctors + Rooms Section (shown when students > 70) -->
        <div id="extraProctorsSection" class="extra-proctors-section" style="display:none;">
            <p class="section-title">
                <i class="fas fa-users ml-1"></i>
                مراقبون وقاعات إضافية — العدد يتجاوز 70 طالباً
            </p>
            <div class="form-row mb-1 d-none" id="extraHeaderRow">
                <div class="col"><small class="text-muted font-weight-bold">المراقب الإضافي</small></div>
                <div class="col"><small class="text-muted font-weight-bold">القاعة الإضافية المخصصة</small></div>
                <div class="col-auto" style="width:42px;"></div>
            </div>
            <div id="extraProctorsList"></div>
            <button type="button" class="btn-add-proctor mt-2" id="btnAddProctor">
                <i class="fas fa-plus ml-1"></i> إضافة مراقب + قاعة إضافية
            </button>
        </div>

        <hr class="section-divider">

        <!-- Section: Date & Time -->
        <p class="section-title"><i class="fas fa-clock ml-1"></i> التوقيت</p>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="inputDate">
                    <i class="fas fa-calendar-alt ml-1"></i> تاريخ الامتحان
                </label>
                <input type="date" id="inputDate" class="form-control" required>
            </div>
            <div class="form-group col-md-6">
                <label for="inputTime">
                    <i class="fas fa-clock ml-1"></i> وقت الامتحان
                </label>
                <input type="time" id="inputTime" class="form-control" required>
            </div>
        </div>

        <hr class="section-divider">

        <!-- Actions -->
        <div class="d-flex justify-content-end" style="gap: 12px;">
            <a href="@Url.Action("ExamDashBoard", "Exam")" class="btn btn-cancel">
                <i class="fas fa-times ml-1"></i> إلغاء
            </a>
            <button type="button" id="btnSave" class="btn btn-submit">
                <i class="fas fa-save ml-1"></i> جدولة الامتحان
            </button>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var allDoctors = [
        @foreach (var doctor in (IEnumerable<Doctor>)ViewBag.Doctors)
        {
            <text>{ id: @doctor.Id, name: "@doctor.DoctorName" },</text>
        }
    ];

    var allRooms = [
        @foreach (var room in (IEnumerable<Room>)ViewBag.Rooms)
        {
            <text>{ id: @room.Id, name: "@room.Name" },</text>
        }
    ];

    var extraProctorCount = 0;

    $('#inputStudents').on('input', function () {
        checkStudentCount();
    });

    function checkStudentCount() {
        var val = parseInt($('#inputStudents').val());
        if (val > 70) {
            $('#extraProctorsSection').show();
            $('#extraHeaderRow').removeClass('d-none');
        } else {
            $('#extraProctorsSection').hide();
            $('#extraHeaderRow').addClass('d-none');
            $('#extraProctorsList').empty();
            extraProctorCount = 0;
        }
    }

    function buildDoctorOptions(excludeId) {
        var opts = '<option value="">-- اختر مراقباً إضافياً --</option>';
        allDoctors.forEach(function (d) {
            if (d.id !== excludeId) {
                opts += '<option value="' + d.id + '">' + d.name + '</option>';
            }
        });
        return opts;
    }

    function buildRoomOptions(excludeId) {
        var opts = '<option value="">-- اختر قاعة إضافية --</option>';
        allRooms.forEach(function (r) {
            if (r.id !== excludeId) {
                opts += '<option value="' + r.id + '">' + r.name + '</option>';
            }
        });
        return opts;
    }

    $('#btnAddProctor').on('click', function () {
        extraProctorCount++;
        var mainDoctorId = parseInt($('#selectDoctor').val()) || 0;
        var mainRoomId   = parseInt($('#selectRoom').val()) || 0;
        var rowHtml =
            '<div class="form-row align-items-center mb-2" id="extraProctorRow' + extraProctorCount + '">' +
            '<div class="col">' +
            '<select class="form-control custom-select extra-proctor-select">' +
            buildDoctorOptions(mainDoctorId) +
            '</select>' +
            '</div>' +
            '<div class="col">' +
            '<select class="form-control custom-select extra-room-select">' +
            buildRoomOptions(mainRoomId) +
            '</select>' +
            '</div>' +
            '<div class="col-auto">' +
            '<button type="button" class="btn-remove-proctor" onclick="removeExtraProctor(' + extraProctorCount + ')">' +
            '<i class="fas fa-times"></i>' +
            '</button>' +
            '</div>' +
            '</div>';
        $('#extraProctorsList').append(rowHtml);
    });

    function removeExtraProctor(id) {
        $('#extraProctorRow' + id).remove();
    }

    function getExtraDoctorIds() {
        var ids = [];
        $('.extra-proctor-select').each(function () {
            var val = parseInt($(this).val());
            if (val > 0) ids.push(val);
        });
        return ids;
    }

    function getExtraRoomIds() {
        var ids = [];
        $('.extra-room-select').each(function () {
            var val = parseInt($(this).val());
            if (val > 0) ids.push(val);
        });
        return ids;
    }

    function getFormData() {
        return {
            doctorId: parseInt($('#selectDoctor').val()) || 0,
            courseId: parseInt($('#selectCourse').val()) || 0,
            roomId: parseInt($('#selectRoom').val()) || 0,
            examDate: $('#inputDate').val(),
            examTime: $('#inputTime').val(),
            expectedStudents: parseInt($('#inputStudents').val()) || 0,
            extraDoctorIds: getExtraDoctorIds(),
            extraRoomIds: getExtraRoomIds()
        };
    }

    function validateForm() {
        if (!$('#selectDoctor').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار الدكتور المراقب', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#selectCourse').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار المادة', confirmButtonText: 'حسناً' });
            return false;
        }
        var students = parseInt($('#inputStudents').val());
        if (!$('#inputStudents').val() || isNaN(students) || students < 1) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى إدخال عدد الطلاب المتوقع', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#selectRoom').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار القاعة', confirmButtonText: 'حسناً' });
            return false;
        }
        if (students > 70) {
            var rows = $('#extraProctorsList .form-row');
            if (rows.length === 0) {
                Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'عدد الطلاب يتجاوز 70، يرجى إضافة مراقب وقاعة إضافية على الأقل', confirmButtonText: 'حسناً' });
                return false;
            }
            var valid = true;
            rows.each(function () {
                var doc = $(this).find('.extra-proctor-select').val();
                var room = $(this).find('.extra-room-select').val();
                if (!doc || doc === '' || !room || room === '') { valid = false; return false; }
            });
            if (!valid) {
                Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى اختيار المراقب الإضافي والقاعة الإضافية لكل صف', confirmButtonText: 'حسناً' });
                return false;
            }
        }
        if (!$('#inputDate').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى تحديد تاريخ الامتحان', confirmButtonText: 'حسناً' });
            return false;
        }
        if (!$('#inputTime').val()) {
            Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'يرجى تحديد وقت الامتحان', confirmButtonText: 'حسناً' });
            return false;
        }
        return true;
    }

    function submitExam() {
        var data = getFormData();

        $.ajax({
            url: '@Url.Action("AddExamAjax", "Exam")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res.status === 'success') {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم بنجاح',
                        text: res.message,
                        confirmButtonText: 'عرض جدول الامتحانات',
                        confirmButtonColor: '#0d3b70'
                    }).then(function () {
                        window.location.href = '@Url.Action("ExamDashBoard", "Exam")';
                    });

                } else if (res.status === 'conflict') {
                    Swal.fire({
                        icon: 'error',
                        title: 'تعارض في الجدول',
                        text: res.message,
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#c0392b'
                    });

                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: res.message || 'حدث خطأ غير متوقع',
                        confirmButtonText: 'حسناً'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في الاتصال',
                    text: 'تعذّر الاتصال بالخادم. يرجى المحاولة مرة أخرى.',
                    confirmButtonText: 'حسناً'
                });
            }
        });
    }

    $('#btnSave').on('click', function () {
        if (!validateForm()) return;
        submitExam();
    });
</script>
</body>
</html>
