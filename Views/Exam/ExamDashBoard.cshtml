@model IEnumerable<pro_exam.ViewModel.ExamWithAvailableDoctorsViewModel>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جدول الامتحانات</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #dce9f5, #eaf4fb);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        .page-header {
            background: linear-gradient(135deg, #0d3b70, #1a6fa8);
            color: white;
            padding: 22px 30px;
            border-radius: 12px;
            margin-bottom: 28px;
            box-shadow: 0 4px 18px rgba(13, 59, 112, 0.35);
        }
        .page-header h3 { font-weight: 700; margin-bottom: 4px; }
        .page-header small { opacity: 0.85; font-size: 0.9rem; }
        .card-table {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 18px rgba(0,0,0,0.09);
            overflow: hidden;
        }
        .table thead th {
            background: linear-gradient(135deg, #0d3b70, #1a6fa8);
            color: white;
            font-weight: 600;
            border: none;
            text-align: center;
            vertical-align: middle;
            padding: 14px 12px;
        }
        .table tbody td {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
            border-color: #eaf4fb;
        }
        .table tbody tr:nth-child(odd)  { background-color: #f0f7ff; }
        .table tbody tr:nth-child(even) { background-color: #ffffff; }
        .table tbody tr:hover           { background-color: #dce9f5; }
        .badge-room {
            display: inline-block;
            background: #e8f4fd;
            color: #0d3b70;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.82rem;
            font-weight: 600;
            margin: 2px;
        }
        .badge-room.extra {
            background: #fff3cd;
            color: #856404;
        }
        .badge-doctor {
            display: inline-block;
            background: #e8f4fd;
            color: #0d3b70;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.82rem;
            margin: 2px;
        }
        .btn-add {
            background: linear-gradient(135deg, #1e8449, #196f3d);
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            text-decoration: none;
        }
        .btn-add:hover { opacity: 0.9; color: white; text-decoration: none; }
        .btn-excel {
            background: linear-gradient(135deg, #196f3d, #117a65);
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            text-decoration: none;
        }
        .btn-excel:hover { opacity: 0.9; color: white; text-decoration: none; }
        .btn-reset {
            background: linear-gradient(135deg, #922b21, #c0392b);
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
        }
        .btn-reset:hover { opacity: 0.9; color: white; }
        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #7f8c8d;
        }
    </style>
</head>
<body>
<div class="container mt-4 mb-5">

    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-calendar-alt ml-2"></i>
                جدول الامتحانات
            </h3>
            <small>عرض وإدارة جميع الامتحانات المجدولة</small>
        </div>
        <div>
            <a href="@Url.Action("AddExam", "Exam")" class="btn-add ml-2" style="padding:9px 20px; border-radius:8px;">
                <i class="fas fa-plus ml-1"></i> إضافة امتحان
            </a>
            <a href="@Url.Action("GenerateExamReport", "Exam")" class="btn-excel" style="padding:9px 20px; border-radius:8px;">
                <i class="fas fa-file-excel ml-1"></i> تصدير Excel
            </a>
        </div>
    </div>

    <div class="card-table">
        @if (Model.Any())
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>المادة</th>
                        <th>القاعات المحجوزة</th>
                        <th>التاريخ</th>
                        <th>البداية</th>
                        <th>النهاية</th>
                        <th>المراقبون</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td><strong>@exam.ExamId</strong></td>
                            <td>@exam.CourseName</td>
                            <td>
                                <span class="badge-room">
                                    <i class="fas fa-door-open"></i> @exam.RoomName
                                </span>
                                @if (exam.ExtraRoomNames != null && exam.ExtraRoomNames.Any())
                                {
                                    @foreach (var extra in exam.ExtraRoomNames)
                                    {
                                        <span class="badge-room extra">
                                            <i class="fas fa-plus-circle"></i> @extra
                                        </span>
                                    }
                                }
                            </td>
                            <td>@exam.ExamDate.ToString("yyyy-MM-dd")</td>
                            <td>@exam.StartTime.ToString(@"hh\:mm")</td>
                            <td>@exam.EndTime.ToString(@"hh\:mm")</td>
                            <td>
                                @if (exam.AssignedDoctors != null && exam.AssignedDoctors.Any())
                                {
                                    @foreach (var doctor in exam.AssignedDoctors)
                                    {
                                        <span class="badge-doctor">@doctor</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("EditExam", "Exam", new { id = exam.ExamId })"
                                   class="btn btn-warning btn-sm" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteExam" asp-controller="Exam" method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذا الامتحان؟')">
                                    <input type="hidden" name="id" value="@exam.ExamId" />
                                    <button type="submit" class="btn btn-danger btn-sm" title="حذف">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-times fa-3x mb-3"></i>
                <h5>لا توجد امتحانات مجدولة</h5>
                <p>ابدأ بإضافة امتحان جديد من الزر أعلاه</p>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <form asp-action="ResetDatabase" asp-controller="Exam" method="post"
              onsubmit="return confirm('هل أنت متأكد من إعادة تعيين قاعدة البيانات؟ سيتم حذف جميع الامتحانات.')">
            <button type="submit" class="btn-reset">
                <i class="fas fa-trash ml-1"></i> إعادة تعيين قاعدة البيانات
            </button>
        </form>
    </div>

</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>