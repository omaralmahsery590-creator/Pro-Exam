@model IEnumerable<pro_exam.ViewModel.ExamWithAvailableDoctorsViewModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam List</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body { background: linear-gradient(to right, #b3cde0, #6497b1); font-family: Arial, sans-serif; }
        .container { background-color: #fff; border-radius: 10px; padding: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); margin-top: 50px; }
        h2 { color: #0d47a1; }
        th { background-color: #0a325f; color: rgb(0, 0, 0); text-align: center; }
        tbody tr:nth-child(odd) { background-color: #bbdefb; }
        tbody tr:nth-child(even) { background-color: #e3f2fd; }
        tbody tr:hover { background-color: #90caf9; }
    
    </style>
</head>
<body>
    <div class="container">
        <h2 class="text-center mt-3 mb-4">Exam List</h2>

        <div class="row mb-3">
            <div class="col-md-6">
                <a href="@Url.Action("AddExam", "Exam")" class="btn btn-primary">Add New Exam</a>
            </div>
            <div class="col-md-6 text-right">
                <a href="@Url.Action("GenerateExamReport", "Exam")" class="btn btn-success">Download Excel Report</a>
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Course</th>
                    <th>Room</th>
                    <th>Exam Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Assigned Doctors</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in Model)
                {
                    <tr>
                        <td>@exam.ExamId</td>
                        <td>@exam.CourseName</td>
                        <td>@exam.RoomName</td>
                        <td>@exam.ExamDate.ToString("yyyy-MM-dd")</td>
                        <td>@exam.StartTime.ToString(@"hh\:mm")</td>
                        <td>@exam.EndTime.ToString(@"hh\:mm")</td>
                        <td>
                            @if (exam.AssignedDoctors != null && exam.AssignedDoctors.Any())
                            {
                                <ul class="mb-0 pl-3">
                                    @foreach (var doctor in exam.AssignedDoctors)
                                    {
                                        <li>@doctor</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>No assigned doctors</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("EditExam", "Exam", new { id = exam.ExamId })" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                            <form asp-action="DeleteExam" asp-controller="Exam" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@exam.ExamId" />
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash-alt"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <form asp-action="ResetDatabase" asp-controller="Exam" method="post" style="text-align:center; margin: 30px;"
          onsubmit="return confirm('Are you sure you want to reset all exams?');">
        <button type="submit" class="btn btn-danger">Reset Database</button>
    </form>
</body>
</html>
