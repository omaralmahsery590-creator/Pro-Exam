<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT College Eaxm Schedule</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary: #0d47a1;
            --primary-light: #1565c0;
            --primary-dark: #0a2e6e;
            --accent: #42a5f5;
        }
        body {
            background-color: #f0f4f8;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

        /* ===== HEADER ===== */
        .main-header {
            background-color: #0d47a1;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .brand-area {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }
        .brand-area img {
            height: 40px;
            width: auto;
            filter: brightness(0) invert(1);
        }
        .brand-name {
            color: #fff;
            font-size: 1.15rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .brand-name span {
            color: #90caf9;
            font-size: 0.72rem;
            font-weight: 400;
            display: block;
        }

        /* User area */
        .user-area {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .user-name-text { font-size: 0.88rem; font-weight: 600; color: #fff; }
        .btn-logout {
            background-color: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 8px;
            padding: 7px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .btn-logout:hover { background-color: rgba(255, 255, 255, 0.28); }

        /* ===== NAVIGATION ===== */
        .main-nav {
            background-color: #1565c0;
            padding: 0 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        .main-nav .navbar-nav { gap: 2px; }
        .main-nav .nav-link {
            color: rgba(255, 255, 255, 0.82) !important;
            padding: 12px 16px !important;
            font-size: 0.88rem;
            font-weight: 500;
            border-bottom: 3px solid transparent;
            transition: all 0.2s;
            border-radius: 0;
        }
        .main-nav .nav-link:hover {
            color: #fff !important;
            border-bottom-color: var(--accent);
            background: rgba(255, 255, 255, 0.1);
        }
        .main-nav .nav-link i { margin-left: 6px; font-size: 0.82rem; }
        .navbar-toggler { border-color: rgba(255,255,255,0.35); padding: 4px 8px; }
        .navbar-toggler-icon { filter: brightness(0) invert(1); }

        /* ===== CONTENT ===== */
        .content-wrapper { padding: 28px 16px; }

        /* ===== FOOTER ===== */
        .main-footer {
            background: #fff;
            border-top: 1px solid #e0e0e0;
            padding: 14px 24px;
            text-align: center;
            color: #90a4ae;
            font-size: 0.8rem;
            margin-top: 48px;
        }
    </style>
</head>
<body>
@{
    var userName = User.FindFirst("given_name")?.Value
                   ?? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                   ?? "المستخدم";
}

<!-- Header -->
<header class="main-header">
    <a href="@Url.Action("ExamDashBoard", "Exam")" class="brand-area">
        <img src="~/images/Pro_Exam.png" alt="Pro Exam" />
        <div class="brand-name">
            IT College Exam Schedule
            <span>نظام إدارة الامتحانات الجامعية</span>
        </div>
    </a>

    <div class="user-area">
        <span class="user-name-text">@userName</span>
        <form asp-action="Logout" asp-controller="Auth" method="post" style="margin:0;">
            <button type="submit" class="btn-logout">
                <i class="fas fa-sign-out-alt me-1"></i>تسجيل الخروج
            </button>
        </form>
    </div>
</header>

<!-- Navigation Bar -->
<nav class="main-nav navbar navbar-expand-md">
    <div class="container-fluid px-0">
        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavLinks">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavLinks">
            <ul class="navbar-nav">
                
               
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Doctor" asp-action="AddNewDoctor">
                        <i class="fas fa-user-md"></i>الدكاترة والمواد
                    </a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" asp-controller="Exam" asp-action="AddExam">
                        <i class="fas fa-plus-circle"></i>إضافة امتحان
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Exam" asp-action="ExamDashBoard">
                        <i class="fas fa-calendar-alt"></i>جدول الامتحانات
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Exam" asp-action="StudentExamSchedule">
                        <i class="fas fa-graduation-cap"></i>جدول الطلاب
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Page Content -->
<div class="container-fluid content-wrapper">
    @RenderBody()
</div>

<!-- Footer -->
<footer class="main-footer">
    &copy; 2026 IT College Exam Schedule &mdash; نظام إدارة الامتحانات الجامعية
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
